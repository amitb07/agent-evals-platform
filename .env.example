# Copy to .env. Only ANTHROPIC_API_KEY is needed, and only to run new experiments; the demo needs
# no key. docker compose sets DATABASE_URL, DATA_DIR and REPO_DIR itself.
ANTHROPIC_API_KEY=

# Optional overrides (defaults shown).
# JUDGE_MODEL=claude-opus-5
# HARBOR_RETRIES=2
# HARBOR_CONCURRENCY=4          # `pnpm oracle` only
# HERMES_IMAGE=evals/hermes-runner:latest
# VERIFIER_IMAGE=evals/verifier:latest
