{
  "name": "agent-evals",
  "private": true,
  "packageManager": "pnpm@10.29.1",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --if-present dev",
    "build": "pnpm -r build",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "pnpm -r --if-present test",
    "db:migrate": "pnpm --filter @evals/db migrate:deploy",
    "sync": "pnpm --filter @evals/api sync",
    "images:build": "docker build -t evals/hermes-runner:latest docker/hermes && docker build --target verifier -t evals/verifier:latest -f docker/Dockerfile ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2"
  }
}
